{
  "name": "kana-desktop-shortcuts",
  "version": "0.4.16",
  "license": "MIT",
  "type": "module",
  "description": "Keyboard shortcuts for DSH Desktop and DSH Web, including an Alt+Tab style session switcher",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "shortcuts",
    "keyboard",
    "session-switcher",
    "alt-tab"
  ],
  "author": "KhalilJar",
  "homepage": "https://github.com/KhalilJar/Remu-desktop-shortcuts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KhalilJar/Remu-desktop-shortcuts.git"
  },
  "bugs": {
    "url": "https://github.com/KhalilJar/Remu-desktop-shortcuts/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
